
# AgentOps Intelligence - Git ignore rules
# Owner: Tony Anuge
# Deliverable: D01

# Python virtual environments
.venv/
venv/

# Python bytecode and caches
__pycache__/
*.py[cod]

# Test and static analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local editor configuration
.vscode/

# Local environment variables and secrets
.env
.env.*
!.env.example

# AWS local credentials
.aws/

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Terraform local files and state
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
crash.log
crash.*.log

# Local database files
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3
*.db

# Local PostgreSQL data directories
pgdata/
postgres_data/

# Temporary files and logs
*.log
*.tmp
